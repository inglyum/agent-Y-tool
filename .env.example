# INGLY xTool Expert Agent — variabili d'ambiente (copia in .env e compila; .env è escluso da Git)

# --- Base ---
INGLY_ENV=production                    # development | production
INGLY_DATABASE_PATH=./data/ingly.db
INGLY_COOKIE_SECURE=true                # true dietro HTTPS (obbligatorio in produzione)
# Chiave per cifrare i token OAuth: genera con `python -m ingly gen-key`. Non cambiarla dopo il collegamento degli account.
INGLY_TOKEN_ENCRYPTION_KEY=
# Primo amministratore (creato all'avvio se non esiste; poi puoi rimuovere queste righe)
INGLY_ADMIN_EMAIL=
INGLY_ADMIN_PASSWORD=

# --- Provider AI ---
INGLY_AI_PROVIDER=none                  # none | anthropic
INGLY_AI_MODEL=claude-opus-5-5
INGLY_AI_API_KEY=                       # se vuoto l'SDK usa ANTHROPIC_API_KEY o il profilo `ant auth login`
INGLY_AI_TIMEOUT_S=60
INGLY_AI_MAX_RETRIES=3

# --- Meta (Facebook Pages / Instagram professionale) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://TUO-DOMINIO/api/social/meta/callback
META_WEBHOOK_VERIFY_TOKEN=              # stringa casuale a tua scelta, uguale a quella impostata nella app Meta
META_GRAPH_VERSION=v21.0                # aggiornare alla versione corrente indicata da Meta

# --- Crawler ---
INGLY_CRAWLER_USER_AGENT=INGLYKnowledgeBot/1.0 (+https://TUO-DOMINIO/contatti)
INGLY_CRAWLER_DELAY_S=2
INGLY_CRAWLER_MAX_PAGES=200
